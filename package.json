{
    "name": "vue-template-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,vue}'",
        "type-check": "vue-tsc -b",
        "prettier": "pnx prettier . --write",
        "format": "pnpm type-check && pnpm lint && pnpm prettier"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    }
}
